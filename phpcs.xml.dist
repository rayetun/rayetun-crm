<?xml version="1.0"?>
<ruleset name="RayEtun CRM">
	<description>Coding standards for RayEtun CRM.</description>

	<file>.</file>

	<!-- Exclude build tooling and dependencies. -->
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>

	<arg value="ps"/>
	<arg name="extensions" value="php"/>

	<rule ref="WordPress">
		<!-- The plugin uses its own custom tables; direct DB access is expected. -->
	</rule>

	<config name="minimum_supported_wp_version" value="6.2"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="rayetun-crm"/>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="rayetun_crm"/>
				<element value="Rayetun_CRM"/>
				<element value="RAYETUN_CRM"/>
			</property>
		</properties>
	</rule>
</ruleset>
